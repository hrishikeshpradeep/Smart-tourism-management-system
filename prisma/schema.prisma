generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TOURIST
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TripStatus {
  DRAFT
  PLANNED
  COMPLETED
  CANCELLED
}

enum BudgetCategory {
  TRANSPORT
  STAY
  FOOD
  ACTIVITY
  OTHER
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum ProviderType {
  HOTEL
  RESTAURANT
  VEHICLE
  GUIDE
}

enum EmergencyStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  passwordHash    String
  role            Role             @default(TOURIST)
  phone           String?
  preferencesJson Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  trips           Trip[]
  wishlists       Wishlist[]
  reviews         Review[]
  bookingRequests BookingRequest[]
  emergencyAlerts EmergencyAlert[]
}

model Destination {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  city        String
  state       String
  category    String
  summary     String
  dailyCost   Decimal       @db.Decimal(10, 2)
  rating      Decimal       @default(0) @db.Decimal(2, 1)
  bestSeason  String
  imageUrl    String?
  latitude    Decimal?      @db.Decimal(9, 6)
  longitude   Decimal?      @db.Decimal(9, 6)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  attractions Attraction[]
  trips       Trip[]
  wishlists   Wishlist[]
  reviews     Review[]
  providers   ServiceProvider[]
  routeStops  TripStop[]
  emergencyAlerts EmergencyAlert[]
}

model Attraction {
  id            String        @id @default(cuid())
  destinationId String
  name          String
  category      String
  description   String
  entryFee      Decimal       @default(0) @db.Decimal(10, 2)
  durationMin   Int?
  openingHours  String?
  status        ContentStatus @default(PUBLISHED)
  destination   Destination   @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  itineraryItems ItineraryItem[]
  wishlists     Wishlist[]
}

model Trip {
  id            String      @id @default(cuid())
  userId        String
  destinationId String
  title         String
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  travelers     Int         @default(1)
  budget        Decimal     @db.Decimal(10, 2)
  travelStyle   String?
  status        TripStatus  @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id])
  itineraryDays ItineraryDay[]
  budgetItems   BudgetItem[]
  bookingRequests BookingRequest[]
  routeStops     TripStop[]
}

model ItineraryDay {
  id        String          @id @default(cuid())
  tripId    String
  dayDate   DateTime        @db.Date
  dayNumber Int
  notes     String?
  trip      Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items     ItineraryItem[]
  @@unique([tripId, dayNumber])
}

model ItineraryItem {
  id             String        @id @default(cuid())
  itineraryDayId String
  attractionId   String?
  title          String
  startTime      String?
  durationMin    Int?
  sequence       Int
  estimatedCost  Decimal       @default(0) @db.Decimal(10, 2)
  notes          String?
  itineraryDay   ItineraryDay  @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  attraction     Attraction?   @relation(fields: [attractionId], references: [id], onDelete: SetNull)
  @@unique([itineraryDayId, sequence])
}

model BudgetItem {
  id         String         @id @default(cuid())
  tripId     String
  category   BudgetCategory
  amount     Decimal        @db.Decimal(10, 2)
  source     String?
  isOverride Boolean        @default(false)
  trip       Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id            String       @id @default(cuid())
  userId        String
  destinationId String?
  attractionId  String?
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  attraction    Attraction?  @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  @@unique([userId, destinationId])
  @@unique([userId, attractionId])
}

model Review {
  id            String       @id @default(cuid())
  userId        String
  destinationId String
  rating        Int
  body          String
  status        ReviewStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  @@unique([userId, destinationId])
}

model BookingRequest {
  id           String        @id @default(cuid())
  userId       String
  tripId       String?
  providerType ProviderType
  providerName String
  providerId   String?
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  guests       Int
  note         String?
  status       BookingStatus @default(PENDING)
  adminNote    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip         Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  provider     ServiceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
}

model TripStop {
  id            String      @id @default(cuid())
  tripId        String
  destinationId String
  sequence      Int
  crowdLevel    String?
  visitWindow   String?
  trip          Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  @@unique([tripId, sequence])
}

model ServiceProvider {
  id            String        @id @default(cuid())
  destinationId String
  providerType  ProviderType
  name          String
  description   String
  contactPhone  String?
  priceFrom     Decimal?      @db.Decimal(10, 2)
  status        ContentStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  destination   Destination   @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  bookings      BookingRequest[]
  @@unique([destinationId, providerType, name])
  @@index([destinationId, providerType])
}

model EmergencyAlert {
  id            String          @id @default(cuid())
  userId        String
  destinationId String?
  latitude      Decimal?        @db.Decimal(9, 6)
  longitude     Decimal?        @db.Decimal(9, 6)
  message       String?
  status        EmergencyStatus @default(OPEN)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination?    @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
}
